---
// Kort til ét stykke udstyr: billede og en knap videre til detailview
const { img, headline, id } = Astro.props;
---

<article class="udstyr-kort">
  <img src={img} alt={`Billede af ${headline}`} />
<a href={`/udstyr/${id}`} class="knap_se-udstyr">Se udstyr</a></article>

<style>
  .udstyr-kort {
    background-color: #ffccd3;
    padding: 1.5rem;
    display: grid;
    justify-items: center; /* centrerer billede og knap */
    gap: 1.5rem;
  }
</style>