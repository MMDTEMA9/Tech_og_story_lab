---
import { Image } from "astro:assets";

const {img, imgvisararbete, kamerakontakt, specialist, inriktning, subtitel, mail, telefon, erfarenhet, erfarenhettext1, erfarenhettext2, erfarenhettext3, maskot5, maskot6} = Astro.props;
---
 
<article class="cardfototext">
   
<!-- venster column -->
 <div class="venstercolumn">
 <Image src={img} alt=`Billede af ${img}` />


 <div class="sectiontextunderfoto">
    <h4 class="h4_special_rod">{specialist}</h4>
    <h4 class="h4_special_rod">{inriktning}</h4>
    <h5 class="h5_special_rod ">{subtitel}</h5>
    <h6 class="h6_special_sort">{mail}</h6>
    <h6 class="h6_special_sort">{telefon}</h6>
    </div>
</div>

<!-- hoger column -->

 <div class="hogercolumn">
      <Image src={imgvisararbete} alt=`Billede af en man i arbete med kameraudstyr`/>

         <div class="gronruta">
    <h4 class="h4_special_rod">{erfarenhet}</h4>
    <h6 class="h6_special_sort">{erfarenhettext1}</h6>
    <h6 class="h6_special_sort">{erfarenhettext2}</h6>
         </div>
         <div class="citat">
    <p>Gode idéer starter med nysgerrighed.</p>
</div>

<div class="ekstrabilled">
    <Image src={kamerakontakt} alt=`Billede pa en kamera` />
          <h5 class="h5_special_rod">{erfarenhettext3}</h5>
 </div>

</div>
</article>


<!------ mobil ----->

<style>

    /* gradient på bakgrunden */
body{
       background: linear-gradient(to bottom, var(--baggrundsfarve), var(--pink-salmon-lyserød), var(--disco-950-farve));
    }

/* styling av hela "cardet" foto + text */
    .cardfototext{
    display: flex;
    align-items: flex-start;
    margin-top: 10rem;
    }


    /* styling av vänstercolumn */
.venstercolumn{
        width: 190px;
        margin-left: 1rem;
     
}

/* styling av höger column */
.hogercolumn{
       width: 120px;
       margin-left: 1.7rem;
      
}

/* sectionen under foto på arbetare */
.sectiontextunderfoto{
    background-color: var(--pink-salmon-lyserød);
    padding: 1rem;
}


/* styling av img till höger */
 .hogercolumn img {
    width: 120%;
    height: auto;
    object-fit: cover;
    display: block;
}

/* styling av grön ruta */
.gronruta {
    height: 170px;
    background-color: var(--neongrøn-farve);
    padding:0.5rem;
     width: 120%; 
    
}

.gronruta h6{
    margin-top: 0.5rem;
}

/* de två extra elementerna ska inte visas i mobile version */
.citat,
.ekstrabilled {
    display: none;
}



  /***** DESKTOP *****/
  /* Alt herinde gælder kun når skærmen er 768px eller bredere */

  @media (min-width: 768px) {
.cardfototext {
    display: flex;
        justify-content: center;
}
        /* de två sista elementerna visas i desktop */
    .citat,
    .ekstrabilled {
        display: block;
    
}

/* ändring av layout grid i desktop */
    .cardfototext {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        grid-template-rows: repeat(4, 1fr);
        align-items: stretch;
        gap: 1rem;
        width: 80%;
        margin: 8rem auto 0;
    }

    .venstercolumn {
        grid-column: 1;
        grid-row: 1 / 4;
        width: 100%;
        margin: 0;
    }

    .venstercolumn img {
        width: 100%;
        display: block;
    }

    .hogercolumn {
        display: contents;
    }

    .hogercolumn img {
        grid-column: 2;
        grid-row: 1/2;
        width: 100%;
    }

    .gronruta {
        grid-column: 3;
        grid-row: 1/2;
         height: auto;
    width: 100%;
        background-color: var(--pink-salmon-lyserød);
    }

    .hogercolumn h5 {
        grid-column: 3;
        grid-row: 2;
    }

    .citat {
        grid-column: 2;
         grid-row: 2/ 4;
         background-color: var(--neongrøn-farve);
         padding: 2rem;
          height: 280px;
    }
    .citat p{
          font-style: italic;
    }
    .ekstrabilled {
        grid-column: 3;
        grid-row: 2/4;
         height: 280px;
    }

    .ekstrabilled img {
    width: 100%;
    height: 100%;
}
}


</style>

