---
// Henter Astros billedværktøj og vores logo
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";
---

<header>
  <nav>
    <!-- Logoet linker til forsiden -->
    <a href="/">
      <Image src={logo} alt="Tech & Story Lab – til forsiden" class="logo" />
    </a>

    <!-- Burger-knappen. De tre span'er bliver til de tre streger -->
    <button class="burger" aria-label="Åbn menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Selve menuen -->
    <ul class="menu">
      <li><a href="/udstyrsliste">Udstyr</a></li>
      <li><a href="/kontaktliste">Kontakt</a></li>
    </ul>
  </nav>
</header>



<style>
  /* ===== MOBIL ===== */
  header {
    background-color: var(--baggrundsfarve);
    padding: 1rem;
    border-bottom: 2px solid var(--pink-salmon-lyserød);
  }

  nav {
    display: flex;
    justify-content: space-between; /* logo til venstre, burger til højre */
    align-items: center;
    flex-wrap: wrap; /* menuen kan lægge sig på en ny linje under logo og burger */
  }

  .logo {
    width: 80px;
  }

  /* Burger-knappen: tre streger under hinanden */
  .burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .burger span {
    display: block;
    width: 28px;
    height: 3px;
    background-color: var(--disco-950-farve);
    border-radius: 3px;
  }

  /* Menuen er skjult på mobil... */
  .menu {
    display: none;
    width: 100%;
    list-style: none;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
  }

  /* ...indtil den får klassen "aaben" */
  .menu.aaben {
    display: flex;
  }

  .menu a {
    color: var(--mørkegrå-farve);
    font-weight: bold;
    text-decoration: none;
    text-transform: uppercase;
  }

  .menu a:hover {
    color: var(--disco-950-farve);
  }

  /* ===== DESKTOP ===== */
  @media (min-width: 1000px) {
    header {
      padding: 1rem 2rem;
    }

    .logo {
      width: 120px;
    }

    /* Burgeren skjules */
    .burger {
      display: none;
    }

    .menu {
      display: flex;
      flex-direction: space-between;
      width: auto;
      gap: 2rem;
      padding-top: 0;
    }
  }
</style>

<!-- /*BURGERMENU*/ -->
<script>
  // Finder burger-knappen og menuen
  const burger = document.querySelector(".burger");
  const menu = document.querySelector(".menu");

  // Når man klikker på burgeren, tilføjes eller fjernes klassen "aaben"
  burger.addEventListener("click", () => {
    menu.classList.toggle("aaben");
  });
</script>