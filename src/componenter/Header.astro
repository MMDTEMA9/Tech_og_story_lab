---
const { headline, text } = Astro.props;
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";
---

<header>
  <nav>
    <a href="/">
        <Image src={logo} alt="Tech & Story Lab – til forsiden" class="logo" />
      </a>

  <ul>
    <li><a href="/udstyrsliste">Udstyr</a></li>
    <li><a href="/kontaktliste">Kontakt</a></li>
  </ul>
</nav>


</header>

<style>
header {
  background-color: var(--baggrundsfarve);
  padding: 1rem 2rem;
  border-bottom: 2px solid var(--pink-salmon-lyserød);
}

/* Menuen */
ul {
  list-style: none;
  display: flex;
  align-items: center;
  gap: 2rem;
}

.logo {
  width: 120px;
}

ul a {
  color: var(--mørkegrå-farve);
  font-weight: bold;
  text-decoration: none;
  text-transform: uppercase;
  padding: 0.3rem 0.8rem;
  border-radius: 10px;
}

ul a:hover {
  background-color: var(--disco-950-farve);
  color: var(--baggrundsfarve);
}

/* Overskrift og tekst under menuen */
h1 {
  font-size: 2rem;
  color: var(--disco-950-farve);
  margin-top: 2rem;
  margin-bottom: 0.5rem;
}

p {
  font-size: 1.2rem;
  color: var(--mørkegrå-farve);
  margin-bottom: 1rem;
}
</style>