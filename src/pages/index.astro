---
/* Importerer PageLayout, som er vores layout for alle siderne.
   Det er her, vi har header, footer og global.css. */
import PageLayout from "../layouts/PageLayout.astro";
import udstyrBord from "../assets/udstyr-bord.webp";
import studie from "../assets/studie.webp";
/* Hvorfor skriver man import på 2 forskellige måder?
   Fordi det er to forskellige slags ting:
   - Noget fra Astro (et værktøj):   import { Navn } from "astro:..."
   - Vores egne filer (billede, komponent, layout):   import Navn from "../mappe/fil" */

// Astros værktøj til at vise billeder
import { Image } from "astro:assets";

// Vores egne billeder fra assets-mappen
import herobillede from "../assets/udstyr.webp";
import maskot1 from "../assets/maskot1.webp";
import maskot2 from "../assets/maskot2.webp";
import maskot4 from "../assets/maskot4.webp";
import kamera from "../assets/kamera-10000.webp";
import arcade from "../assets/arcade.webp";

const apiurl = "https://hycvaeerhjimzwdnycyq.supabase.co/rest/v1/";
// Basis-URL'en til vores Supabase-database. URL'en bruges som start-adresse i både udstyrResponse og kontaktResponse.

const udstyrTableName = "udstyr";
const kontaktTableName = "kontakt";
// Vi har to tabeller, og derfor laver vi to variabler.

const key = "sb_publishable_ci0x6ZnxAsDcDBjvVDKdXA_dC-IEzLE";
// Vores API-nøgle, som vi har fået fra Supabase.

const options = {
	headers: {
		apikey: key
	}
};

const udstyrResponse = await fetch(apiurl + udstyrTableName, options);
const udstyrData = await udstyrResponse.json();

const kontaktResponse = await fetch(apiurl + kontaktTableName, options);
const kontaktData = await kontaktResponse.json();

console.log("udstyrData", udstyrData);
console.log("kontaktData", kontaktData);
---

<!-- PageLayout er rammen. Alt mellem <PageLayout> og </PageLayout> kommer ind ved <slot /> i PageLayout.astro -->
<PageLayout title="Forside">
  <section class="forside">

    <section class="hero">
      <h2 class="h2_special_lyserød">TECH &</h2>
      <Image src={maskot1} alt="" class="maskot1" />
      <Image src={herobillede} alt="Kamera, mikrofon, computer og høretelefoner" class="udstyr" />
      <Image src={maskot2} alt="" class="maskot2" />
      <h2 class="h2_special_grøn">STORY LAB</h2>
    </section>

    <section class="intro">
      <h1>Hvad er Tech & Story Lab?</h1>
      <p>I Tech & Story Lab kan du eksperimentere med ny teknologi og på egen hånd lære at arbejde med forskelligt udstyr.</p>

      <div class="datavisualisering">
        <Image src={kamera} alt="Kamera, hvor skærmen viser 10.000 udstyrsudlån om året" />

        <div class="datavisualisering-tekst">
          <p class="tal">10.000</p>
          <p><span>studerende om året</span><br />låner udstyr og bruger faciliteterne i labbet.</p>
        </div>
      </div>

      <!-- Kategorierne ligger nu inde i .intro, så de kan stå i venstre kolonne ved siden af 10.000 på desktop.
           De står efter kameraet, så de stadig kommer under kameraet på mobil. -->
      <div class="kategori-blok">
        <h4>Vi har alt lige fra:</h4>

        <!-- Det efter kategori= skal være præcis som category i Supabase.
             Altså: Kamera, Lyd, Lys, Tripods, monopods og andre stativer, Kamerastabilisator -->
        <div class="kategorier">
          <a href="/udstyrsliste?kategori=Kamera" class="knap_kategori">Kameraer</a>
          <a href="/udstyrsliste?kategori=Lyd" class="knap_kategori">Mikrofoner</a>
          <a href="/udstyrsliste?kategori=Lys" class="knap_kategori">Lysudstyr</a>
          <a href="/udstyrsliste?kategori=Tripods, monopods og andre stativer" class="knap_kategori">Tripods</a>
          <a href="/udstyrsliste?kategori=Kamerastabilisator" class="knap_kategori">Kamera Stabilisers</a>
        </div>

        <!-- "Se udstyr" har ingen ?kategori=, så den viser alt. Den står uden for .kategorier, så den kommer på sin egen linje -->
        <a href="/udstyrsliste" class="knap_se-udstyr">Se udstyr</a>
      </div>
    </section>

    <section class="sektion3 gradient_neongrøn-baggrundsfarve">
      <div>
        <h3>Husk dit studiekort</h3>
        <p>For at låne udstyr og bruge vores faciliteter <br>skal du have <span class="rødtekst">dit studiekort</span> med. <br>
Kortet <span class="rødtekst">skal være gyldigt</span> og må kun bruges af kortets ejer.</p>
      </div>
      <div>
        <h3>Åbningstider:</h3>
        <p>Mandag–torsdag: kl 9-16</p>
        <p>Fredag: kl 9-15</p>
      </div>
      <Image src={arcade} alt="Arcade-maskine med Tech & Story Lab-design" class="arcade" />
    </section>
    <div class="tomsektion"></div>
<section class="sektion4 gradient_pink-salmon-lyserød baggrundsfarve">
  <div class="kort-liste">

    <div class="kort">
      <h2>Vores udstyr</h2>
      <Image src={udstyrBord} alt="Kamera, objektiv, høretelefoner og mikrofon på et bord" class="kort-billede" />
      <a href="/udstyrsliste" class="knap_se-udstyr">Se udstyr</a>
    </div>

    <div class="kort">
      <h2>Vores studios</h2>
      <Image src={studie} alt="To personer bliver fotograferet i fotostudiet" class="kort-billede" />
      <a href="#" class="knap_book-studio">Book studio</a>
    </div>

  </div>
</section>
<section class="sektion5 forside_baggrund-footer">
  <h2>Workshops & Events</h2>

  <div class="workshop-indhold">
    <p class="workshop-tekst">
      Er du interesseret? Kom ned i labbet og få mere information om vores workshops og events.
    </p>
    <Image src={maskot4} alt="" class="workshop-maskot" />
  </div>
</section>
  </section>
</PageLayout>

<style>


  /* Luft til kanterne på alle sektioner under hero.
     Paddingen sidder på sektionen selv, så en baggrundsfarve går helt ud til kanten */
.intro,
.sektion3,
.sektion4,
.sektion5 {
  padding: 2rem 1rem;
}
.intro {
  margin-top: 3rem;    /* luft mellem sektionerne */
  margin-bottom: 1rem; /* luft mellem sektionerne */
}
  /* --- HERO --- */
  .hero {
    position: relative; /* gør det muligt at placere maskotterne frit i hero-sektionen */
    background-color: var(--disco-950-farve);
    display: flex;
    flex-direction: column; /* på mobil står tingene under hinanden */
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 3rem 1rem;
    text-align: center;
  }

  .udstyr {
    width: 90%;
  }

  /* Figurerne sidder i hjørnerne */
  .maskot1 {
    position: absolute;
    top: 2%;   /* 2% fra toppen af hero-sektionen */
    right: 2%; /* 2% fra højre side af hero-sektionen */
    width: 20%;
  }

  .maskot2 {
    position: absolute;
    bottom: 2%; /* 2% fra bunden af hero-sektionen */
    left: 2%;   /* 2% fra venstre side af hero-sektionen */
    width: 20%;
  }

  /* --- INTRO --- */
  .intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .datavisualisering-tekst {
    display: flex;           /* tal og tekst ved siden af hinanden */
    align-items: flex-start; /* toppen af teksten flugter med toppen af tallet */
    gap: 1rem;
    margin-inline-start: auto;
  }

  .tal {
    font-size: 4rem;
    font-weight: bold;
    line-height: 1; /* fjerner ekstra luft over og under tallet */
    color: var(--disco-950-farve);
  }

  .datavisualisering-tekst p:last-child {
    padding-top: 1.3rem; /* skubber teksten lidt ned, så den flugter med tallet */
    max-width: 20ch;     /* styrer hvor teksten brydes */
    line-height: 1.5;
  }

  .datavisualisering-tekst span {
    font-weight: bold;
    color: var(--disco-950-farve);
  }

  /* --- KATEGORIER (ligger nu inde i intro) --- */

  .kategori-blok {
    margin-top: 2rem; /* luft mellem 10.000 og "Vi har alt lige fra" på mobil */
  }

  .kategori-blok h4 {
    margin-bottom: 1rem;
  }

  .kategorier {
    display: flex;
    flex-wrap: wrap; /* knapperne hopper ned på næste linje, hvis der ikke er plads */
    gap: 0.75rem;
  }

  /* "Se udstyr" på sin egen linje under kategoriknapperne */
  .kategori-blok .knap_se-udstyr {
    display: inline-block; /* gør at margin virker på et link */
    margin-top: 1rem;
  }

  /* --- SEKTION 3: studiekort og åbningstider --- */
  .sektion3 {
    display: flex;
    flex-direction: column;
    gap: 2rem; margin-top:30px;
    padding-bottom: 0; /* ingen luft i bunden, så billedet kan stå helt nede */
  }

  /* Luften i bunden ligger nu på teksten i stedet */
  .sektion3 div {
    padding-bottom: 1rem;
  }

  .arcade {
    margin-top: -8rem;    /* trækker billedet op ved siden af åbningstiderne */
    margin-right: 2rem;   /* skubber billedet lidt væk fra højre kant */
    width: 30%;           
    align-self: flex-end; /* billedet til højre */
  }


  .rødtekst {
    color: var(--disco-950-farve);
    font-weight: bold;
  }

  .tomsektion{
    display: none;}



  /* --- SEKTION 4: udstyr og studios --- */
  .kort-liste {
    display: flex;
    flex-direction: column; /* kortene under hinanden på mobil */
    gap: 3rem;/* luft mellem de to kort */
  }

  .kort {
    display: flex;
    flex-direction: column; /* overskrift, billede og knap under hinanden */
    gap: 1rem;
  }

  .kort-billede {
    width: 80%;
    align-self: center; /* billedet i midten */
  }

  .kort a {
    align-self: center; /* knappen i midten  */
    margin-bottom: 60px;
  }
  .sektion4 h2{
    color: var(--disco-950-farve);
    margin-inline: auto;
    margin-top: 20px;
  }

  /* --- SEKTION 5: workshops og events --- */
.sektion5 {
  padding-top: 5rem;    
  padding-bottom: 8rem;
  margin-bottom: 0;      /* går helt ned til footeren */
}

.workshop-tekst {
font-style: italic;
max-width: 30ch;  
margin-top: 20px;
}

.workshop-maskot {
  width: 30%;
  margin-left: auto; /* skubber figuren ud til højre */
  margin-right: 6%;  /* lidt luft til højre kant */
}
  
  /* ===== DESKTOP ===== */
  @media (min-width: 1000px) {

    /* Luft til siderne på alle sektioner under hero */
    .intro,
    .sektion3,
    .sektion4,
    .sektion5 {
      padding-inline: 4rem;
    }

    /* --- HERO --- */
    .hero {
      display: block; /* fjerner flexbox, så vi kan placere tingene frit */
      height: 100vh;  /* hero-sektionen fylder hele skærmen */
      padding: 0;
    }

    .hero .h2_special_lyserød {
      position: absolute;
      top: 5%;
      left: 5%;
    }

    .hero .h2_special_grøn {
      position: absolute;
      bottom: 5%;
      right: 5%;
    }

    .udstyr {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%); /* centrerer billedet både lodret og vandret */
      width: 50%;
    }

    .maskot1 {
      top: 5%;
      right: 5%;
      width: 15%;
    }

    .maskot2 {
      bottom: 2%;
      left: 5%;
      width: 15%;
    }

    /* --- INTRO: tekst og knapper til venstre, kamera til højre --- */
    .intro {
      display: grid;
      grid-template-columns: 3fr 2fr;    /* venstre kolonne er bredere end højre (3 dele mod 2 dele) */
      grid-template-rows: auto auto 1fr; /* h1 og tekst er kun så høje som deres indhold, resten går til knapperne */
      column-gap: 3rem;
      row-gap: 1.5rem;
    }

    .intro h1 {
      grid-column: 1; /* venstre kolonne */
      grid-row: 1;    /* første række */
    }

    /* ">" betyder kun den <p>, der ligger direkte i .intro (ikke teksten ved 10.000) */
    .intro > p {
      grid-column: 1;
      grid-row: 2;
    }

    .kategori-blok {
      grid-column: 1;
      grid-row: 3;
      align-self: start; /* knapperne står lige under teksten, på højde med 10.000 */
      margin-top: 2rem;  /* luft mellem tekst og "Vi har alt lige fra" */
    }

    .datavisualisering {
      grid-column: 2;       /* højre kolonne */
      grid-row: 1 / span 3; /* kameraet fylder hele højre side, ved siden af alle tre rækker */
      margin-top: 1rem;     /* kameraet starter lidt under toppen af overskriften */
    }

    .tal {
 font-size: 5rem;    }
 .datavisualisering-tekst p:last-child {
  padding-top: 0.6rem; /* tallet er mindre, så teksten skal ikke skubbes så langt ned for at flugte */
  max-width: none;     /* lad teksten bruge den plads, der er */
  line-height: 1.4;    /* lidt tættere linjer */
}

    /* --- SEKTION 3: arcade, studiekort og åbningstider på én række --- */
    .sektion3 {
      flex-direction: row;
      align-items: center;
      gap: 5rem;
      padding-top: 2rem;
      padding-bottom: 0;
      margin-top: 9rem;
    }

    .sektion3 div {
      padding-bottom: 2rem;
    }

    .arcade {
      order: -1;            /* flytter arcade først, altså til venstre */
      align-self: flex-end; /* står nede i bunden af sektionen */
      width: 15%;
      margin-top: -6rem;    /* stikker lidt op over sektionen, som i designet */
      margin-right: 0;
    }

    .tomsektion{display: block;padding: 100px;}
    /* --- SEKTION 4: udstyr og studios ved siden af hinanden --- */
    .kort-liste {
      display: flex;
      flex-direction: row;
      gap: 4rem;
    }

    .kort {
      flex: 1; /* de to kort deler pladsen lige */
    }

    .kort-billede {
      width: 70%;
    }

    /* --- SEKTION 5: workshops og events --- */

   .sektion5, .forside_baggrund-footer{
    padding-left:20%;
   }
    .sektion5 {
      padding-top: 6rem;
      padding-bottom: 10rem;
    }

    .workshop-maskot {
      width: 20%;
      margin-right: 20%;
    }
  }
</style>