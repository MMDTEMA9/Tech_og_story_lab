---
import PageLayout from "../layouts/PageLayout.astro";

import css from "../styles/global.css"
/*importerer PageLayout som er vores layout for alle siderne. Det er her vi har header og footer.*/


/*vhvorfor man skriver import på 2 forskellige måder?
SVAR: fordi det er to forskellige slags ting, og så skrives importen forskelligt.

Hvad henter du?	
Noget fra Astro (et værktøj)	import { Navn } from "astro:..."*/

import { Image } from "astro:assets";

/*henter billederne ind fra assets mappen*/
/*vores egen filler (billede, komponent, layout)	import Navn from "../mappe/fil"*/
/*henter billederne ind fra assets mappen*/
import herobillede from "../assets/herobillede.png";
import maskot from "../assets/maskot.png";
import maskot2 from "../assets/maskot2.png";

const apiurl = "https://hycvaeerhjimzwdnycyq.supabase.co/rest/v1/";
//Basis-URL'en til vores Supabase-database. URL'en bruges som start-adresse i både udstyrResponse og kontaktResponse.

const udstyrTableName = "Udstyr";
const kontaktTableName = "kontakt";
// Vi har to tabeller og derfor laver i to variabler. 

const key = "sb_publishable_ci0x6ZnxAsDcDBjvVDKdXA_dC-IEzLE"
// Vores api key som vi har fået fra supabase.

const options = {
	headers: {
		apikey: key
	}
}

const udstyrResponse = await fetch(apiurl + udstyrTableName, options);
const udstyrData = await udstyrResponse.json();

const kontaktResponse = await fetch(apiurl + kontaktTableName, options);
const kontaktData = await kontaktResponse.json();

console.log("udstyrData", udstyrData);
console.log("kontaktData", kontaktData);
---

<PageLayout title="Forside">

  <section class="hero">
    <h2 class="h2_special_lyserød">TECH &</h2>
    <Image src={maskot} alt="chrome illustration af kamera" class="maskot1" />
    <Image src={herobillede} alt=" Billede af kameraudstyr" class="udstyr" />
    <Image src={maskot2} alt="chrome illustration af kamera" class="maskot2" />
    <h2 class="h2_special_grøn">STORY LAB</h2>
  </section>

  <button class="knap_se-udstyr">Se udstyr</button>
  <button class="knap_kategori">Om os</button>
  <button class="knap_book-studio">Book studio</button>

</PageLayout>

<style>
  .hero {
    position: relative;
    height: 100vh;
    background-color: var(--disco-950-farve);
  }

  .udstyr {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50%;
  }

  .maskot1 {
    position: absolute;
    top: 5%;
    right: 5%;
    width: 15%;
  }

  .maskot2 {
    position: absolute;
    bottom: 2%;
    left: 5%;
    width: 15%;
  }
</style>