---
import UdstyrList from "../componenter/UdstyrList.astro";
import "../styles/global.css";
// import { Image } from “../assets/billede.jpg”; 

const apiurl = "https://hycvaeerhjimzwdnycyq.supabase.co/rest/v1/";
//Basis-URL'en til vores Supabase-database. URL'en bruges som start-adresse i både udstyrResponse og kontaktResponse.

const udstyrTableName = "udstyr";


const key = "sb_publishable_ci0x6ZnxAsDcDBjvVDKdXA_dC-IEzLE"
// Vores api key som vi har fået fra supabase.

const options = {
	headers: {
		apikey: key
	}
}

const udstyrResponse = await fetch(apiurl + udstyrTableName, options);
const udstyrData = await udstyrResponse.json();


console.log("udstyrData", udstyrData);

---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
        <section>  
			<div>
				<!-- <Image src”() alt=”logo”/>  ret når billeder er tilføjet til assets -->
				<h1>Alt udstyr - Bookes fysiskt i lab </h1>
			</div>
			<div>
				<p>33 stk</p>
				<!-- lav en fake toggle -->
			</div>
			<div>
					<button class="Filtering_knap">Alt 33</button>
					<button class="Filtering_knap">Kamera 15</button>
					<button class="Filtering_knap">Lyd 3</button>
					<button class="Filtering_knap">Lys 3</button>
					<button class="Filtering_knap">Kamera linser 3</button>
					<button class="Filtering_knap">Kamera stabiliator 3</button>
					<button class="Filtering_knap">Tripods, monopods og andre stativer 3</button>
					<p class="Filtering_tekst" class="Søgning_tekst">Søg fx "mikrofon"</p>
			</div>
			<div class="overblik_container">
				<p class="Filtering_tekst">FOTO</p>
				<p class="Filtering_tekst">UDSTYR</p>
				<p class="Filtering_tekst">KATEGORI</p>
				<p class="Filtering_tekst">STATUS</p>
				<p class="Filtering_tekst">LÅNETID</p>
			</div>
            
             <div>
                {
                udstyrData.map((data) => {
                    return <UdstyrList {data} />
                })
                }
            </div>
        </section>
	</body>
</html>
<style>

/* Mobil style */

/* Styling af overblikstekst (den tekst om ligger over udstyret f.eks kategori og status) */
.Filtering_tekst{
	color: #6D717F;
	font-weight: 400;
	font-size: 1rem;
}
.overblik_container{
	display: flex; /* Gør det muligt at bruge flexbox-egenskaber */
 flex-direction: row; /* Lægger elementerne vandret (standard ved flex) */
  align-items: center; /* Centrerer teksten lodret på linjen */
  gap: 2rem; 
}
.Søgning_tekst{
background-color: #F5F5F5;
  border: 1px solid #E0E0E0;
  border-radius: 20px;
 
  }

.Filtering_knap {
  background-color: #FFFFFF;
  border: 1px solid var( --disco-950-farve);
  color: var(--disco-950-farve);
  cursor: pointer;
  border-radius: 20px;
  margin: 5px;
  padding: 5px 10px;
  font-size: 1rem;
}
.Filtering_knap:hover {
  background-color: var(--disco-950-farve);
  color: var(--baggrundsfarve);
  cursor: pointer;
  
}

