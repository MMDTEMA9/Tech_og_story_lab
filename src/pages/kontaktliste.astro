---
import "../styles/global.css";
import PageLayout from "../layouts/PageLayout.astro";
import Kontraktcard from "../componenter/Kontraktcard.astro";
import Modholdetcard from "../componenter/Modholdetcard.astro";
import { Image } from "astro:assets";
import frederik from "../assets/Frederik.webp";
import luke from "../assets/Luke.webp";
import mikki from "../assets/Mikki.webp";
import kristoffer from "../assets/Kristoffer.webp";
import nicolas from "../assets/Nicolas.webp";
import emelie from "../assets/Emelie.webp";
import daniel from "../assets/Daniel.webp";
import visararbete from "../assets/visararbete.webp";
import maskot5 from "../assets/maskot5.webp";
import maskot6 from "../assets/maskot6.webp";
import maskot4 from "../assets/maskot4.webp";
import type { AstroComponentInstance } from "astro/runtime/server/index.js";
import type { astro } from "astro/fetch";
---

<PageLayout title="kontaktliste">
    <div class="ternetbakgrund">
       <div class="marginruntom">
 <section class="holdetcard">
            <div class="frederik">
            <Modholdetcard img={frederik} text={"Frederik"} />
       </div>
           <div class="luke">
            <Modholdetcard img={luke} text={"Luke"} />
           </div>
             <div class="mikki">
            <Modholdetcard img={mikki} text={"Mikki"}/>
             </div>
              <div class="kristoffer">
            <Modholdetcard img={kristoffer} text={"Kristoffer"}/>
             </div>

            <div class="overskrift">
                    <h2 class="h2_special_vit">MØD HOLDET</h2>
                    <h5 class="h3_special_vit">PÅ TECH & STORY LAB</h5>
            </div>
        
                  <div class="nicolas">
            <Modholdetcard img={nicolas} text={"Nicolas"}/>
                   </div>
                     <div class="emelie">
            <Modholdetcard img={emelie} text={"Emelie"} />
                  </div>
                   <div class="daniel">
            <Modholdetcard img={daniel} text={"Daniel"}/>
     </div>
     
            </section>
    </div>
</div> 
     


        <section>
        <!-- Alla cards -->
         <Kontraktcard img={frederik} imgvisararbete={visararbete} specialist="LAB-MANAGER" inriktning="EYETRACKING" subtitel="KONTAKT MIG" mail="frfr@ek.dk" telefon="+45 46 46 04 42" erfarenhet="10+ ÅR" erfarenhettext1="Erfaring inden for foto, video og produktion." erfarenhettext2="Specialiseret i visuel kommunikation og teknisk produktion."  erfarenhettext3="ERFARING OG KOMPETENCER"  />
        <Kontraktcard img={luke} imgvisararbete={visararbete} specialist="LAB-SPECIALIST" inriktning="AI" subtitel="KONTAKT MIG" mail="frfr@ek.dk" telefon="+45 46 46 04 42"erfarenhet="10+ ÅR" erfarenhettext1="Erfaring inden for foto, video og produktion." erfarenhettext2="Specialiseret i visuel kommunikation og teknisk produktion." erfarenhettext3="ERFARING OG KOMPETENCER"/>
        <div class="maskot5"> <Image src={maskot5} alt=`Billede af en crome logo`/> </div>
        <Kontraktcard img={mikki} imgvisararbete={visararbete} specialist="LAB-ASSISTENT" inriktning="FOTO & LYDFORTÆLLING" subtitel="KONTAKT MIG" mail="frfr@ek.dk" telefon="+45 46 46 04 42"erfarenhet="10+ ÅR" erfarenhettext1="Erfaring inden for foto, video og produktion." erfarenhettext2="Specialiseret i visuel kommunikation og teknisk produktion." erfarenhettext3="ERFARING OG KOMPETENCER"/>
        <Kontraktcard img={kristoffer} imgvisararbete={visararbete} specialist="LAB-ASSISTENT" inriktning="LYS & KODE" subtitel="KONTAKT MIG" mail="frfr@ek.dk" telefon="+45 46 46 04 42"erfarenhet="10+ ÅR" erfarenhettext1="Erfaring inden for foto, video og produktion." erfarenhettext2="Specialiseret i visuel kommunikation og teknisk produktion." erfarenhettext3="ERFARING OG KOMPETENCER"/>
         <div class="maskot6"> <Image src={maskot6} alt=`Billede af en crome logo`/> </div>
        <Kontraktcard img={nicolas} imgvisararbete={visararbete} specialist="FOTO" subtitel="KONTAKT MIG" mail="frfr@ek.dk" telefon="+45 46 46 04 42"erfarenhet="10+ ÅR" erfarenhettext1="Erfaring inden for foto, video og produktion." erfarenhettext2="Specialiseret i visuel kommunikation og teknisk produktion." erfarenhettext3="ERFARING OG KOMPETENCER"/>
        <Kontraktcard img={emelie} imgvisararbete={visararbete} specialist="LYDFORTÆLLING" subtitel="KONTAKT MIG" mail="frfr@ek.dk" telefon="+45 46 46 04 42"erfarenhet="10+ ÅR" erfarenhettext1="Erfaring inden for foto, video og produktion." erfarenhettext2="Specialiseret i visuel kommunikation og teknisk produktion."erfarenhettext3="ERFARING OG KOMPETENCER"/>
         <div class="maskot4"> <Image src={maskot4} alt=`Billede af en crome logo`/> </div>
        <Kontraktcard img={daniel} imgvisararbete={visararbete} specialist="VIDEO" subtitel="KONTAKT MIG" mail="frfr@ek.dk" telefon="+45 46 46 04 42"erfarenhet="10+ ÅR" erfarenhettext1="Erfaring inden for foto, video og produktion." erfarenhettext2="Specialiseret i visuel kommunikation og teknisk produktion."erfarenhettext3="ERFARING OG KOMPETENCER"/>
        </section>


       
</PageLayout>
   
<style>
    /* stylar maskotarna på sidan. margin-left auto lägger maskoten så mycket margin som möjligt till vänster om elementet. Position absolute gör att jag kan placera maskot vart jag vill */
 
    .maskot5, .maskot6{
 width: 40%;
position: absolute;
}

.maskot4{
     width: 30%;
     position: absolute;
 
}

 
/* enkel styling på mødholdet */
.ternetbakgrund{
    background-image: url(src/assets/ternetbaggrund.png);

}

.marginruntom{
    margin: 1rem;
    border: 20px solid var(--disco-950-farve);
    background-color: var(--disco-950-farve);
    border-radius: 10px;
}


/* layout på grid för "mødholdet" */

.holdetcard {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

}

.holdetcard .frederik {
    grid-column: 1;
    grid-row: 1;
}

.luke {
    grid-column: 2;
    grid-row: 1;
}

.mikki {
    grid-column: 3;
    grid-row: 1;
}

.kristoffer {
    grid-column: 1;
    grid-row: 2;
}

.overskrift {
    grid-column: 2 / 4;
    grid-row: 2;
    margin-left: 0.5rem;
    margin-top: 0.5rem;
}

.nicolas {
    grid-column: 1;
    grid-row: 3;
}

.emelie {
    grid-column: 2;
    grid-row: 3;
}

.daniel {
    grid-column: 3;
    grid-row: 3;
    }


  /***** DESKTOP *****/
  /* Alt herinde gælder kun når skærmen er 768px eller bredere */
  @media (min-width: 768px) {

    /* flyttar mødholdet till mitten av sidan*/
    .marginruntom{
        /* auto centrerar innehållet horisotellt automatiskr */
    margin: auto;
    width: 40%;
    border: 30px solid var(--disco-950-farve);
    background-color: var(--disco-950-farve);
    border-radius: 10px;
    }
/* ändrar bakgrund , min-height betyder minsta höjd och 100vh = 100 % av skärmens höjd */
    .ternetbakgrund{
        padding-top: 2rem;
        padding-bottom: 2rem;
       background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 110vh;
    }

  
  }
</style>