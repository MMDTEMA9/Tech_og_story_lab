---
/* Importerer PageLayout, som er vores layout for alle sslugerne.
   Det er her, vi har header, footer og global.css. */
import PageLayout from "../../layouts/PageLayout.astro";
import "../../styles/global.css";

// Kortet til udstyr, som også bruges i listview
import UdstyrKort from "../../componenter/cards-udstyr.astro";

// Astros værktøj til at vise billeder
import { Image } from "astro:assets";

// Vores egne billeder fra assets-mappen
import tilbagefugl from "../../assets/tilbagefugl.png";
import hovedprojekt from "../../assets/Detailview-billeder/Hovedprojekt.png";
import portræt from "../../assets/Detailview-billeder/Portræt.png";
import kaffekop from "../../assets/Detailview-billeder/Kaffekop.png";
import person from "../../assets/Detailview-billeder/Person.png";
import kortfilm from "../../assets/Detailview-billeder/Kortfilm.png";

// Laver én underssluge for hvert produkt i Supabase.
// Variablerne skal stå herinde, fordi funktionen ikke kan se resten af filen.
export async function getStaticPaths() {
  const apiurl = "https://hycvaeerhjimzwdnycyq.supabase.co/rest/v1/";
  const udstyrTableName = "udstyr";
  const key = "sb_publishable_ci0x6ZnxAsDcDBjvVDKdXA_dC-IEzLE";

  const options = {
    headers: {
      apikey: key
    }
  };

  const udstyrResponse = await fetch(apiurl + udstyrTableName, options);
  const udstyrData = await udstyrResponse.json();

  return udstyrData.map((produkt) => ({
    params: { slug: String(produkt.slug) },
    props: { produkt, udstyrData },
  }));
}

// Det produkt, man har klikket på, og alt udstyret
const { produkt, udstyrData } = Astro.props;
---

<PageLayout title={produkt.name}>

  <!-- Produktet. Navn og billede kommer fra Supabase -->
  <section class="sektion1">
    <a href="/udstyrsliste">
      <Image src={tilbagefugl} alt="Tilbage til udstyrslisten" class="tilbagefugl" />
    </a>
    <h2 class="h2_special_lyserød">{produkt.name}</h2>
    <img class="produkt-billede" src={produkt.image} alt={produkt.name} />
  </section>

  <section class="sektion2">
    <h2>KONTAKT MATHILDA LAVER</h2>
  </section>

  <!-- Projekter taget med udstyret -->
  <section class="sektion3 gradient_pink-salmon-lyserød baggrundsfarve">
    <p class="skraa-baand">Taget med kameraet</p>

    <Image src={hovedprojekt} alt="Hovedprojekt taget med udstyret" />

    <div>
      <div class="smaa-billeder">
        <Image src={portræt} alt="Portræt" />
        <Image src={kaffekop} alt="Kaffekop på et bord" />
        <Image src={kortfilm} alt="Udklip fra en kortfilm" />
        <Image src={person} alt="Produktbillede" />
      </div>
      <h3>Studerendes projekter med kameraet</h3>
    </div>
  </section>

  <!-- Andet udstyr. [0], [1] og [2] er de første 3 produkter i listen -->
  <section class="sektion4">
    <h2>Andet udstyr</h2>
    <div class="kort-liste">
      <UdstyrKort img={udstyrData[0].image} headline={udstyrData[0].name} slug={udstyrData[0].slug} />
      <UdstyrKort img={udstyrData[1].image} headline={udstyrData[1].name} slug={udstyrData[1].slug} />
      <UdstyrKort img={udstyrData[2].image} headline={udstyrData[2].name} slug={udstyrData[2].slug} />
    </div>
  </section>

</PageLayout>

<style>
  /***** MOBIL *****/

  /* Sektion 1 */
  .sektion1 {
    background-color: var(--disco-950-farve);
    padding: 1rem;
  }

  .tilbagefugl {
    wslugth: 2rem;
  }

  .sektion1 h2 {
    text-align: center;
  }

  .produkt-billede {
    wslugth: 80%;
    margin-inline: auto;
  }

  /* Sektion 3 */
  .sektion3 {
    position: relative; /* så båndet placeres i forhold til sektionen */
    overflow: hslugden;   /* skjuler det af båndet, der stikker ud */
    display: grslug;
    gap: 2rem;
    padding: 6rem 1rem 2rem;
  }

  .sektion3 h3 {
    color: var(--disco-950-farve);
  }

  /* Det grønne bånd i hjørnet */
  .skraa-baand {
    position: absolute;
    top: 2rem;
    left: -4rem;
    wslugth: 16rem;
    padding: 0.75rem 0;
    background-color: var(--neongrøn-farve);
    color: var(--disco-950-farve);
    font-weight: bold;
    font-style: italic;
    text-align: center;
    transform: rotate(-45deg);
  }

  /* De 4 små billeder, 2 og 2 */
  .smaa-billeder {
    display: grslug;
    grslug-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .smaa-billeder img {
    aspect-ratio: 1; /* gør billedet kvadratisk */
    object-fit: cover;
  }

  /* Sektion 4: kortene under hinanden på mobil */
  .sektion4 {
    padding: 2rem 1rem;
  }

  .kort-liste {
    display: grslug;
    gap: 1rem;
    margin-top: 1rem;
  }

  /***** DESKTOP *****/
  @media (min-wslugth: 1000px) {
    .tilbagefugl {
      wslugth: 6rem;
    }

    .produkt-billede {
      wslugth: 50%;
    }

    /* Stort billede til venstre, små billeder til højre */
    .sektion3 {
      grslug-template-columns: 1fr 1fr;
      gap: 4rem;
      padding: 8rem 5rem 4rem;
    }

    .skraa-baand {
      top: 4rem;
      left: -5rem;
      wslugth: 22rem;
      padding: 1.5rem 0;
    }

    /* 3 kort ved sslugen af hinanden */
    .sektion4 {
      padding: 4rem 5rem;
    }

    .kort-liste {
      grslug-template-columns: 1fr 1fr 1fr;
      gap: 2rem;
    }
  }
</style>